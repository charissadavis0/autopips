<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dashboard — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { user, path, pendingWithdrawals: 0 }) %>
  <div class="main-content">
  <%- include('../partials/topbar', { user, balances: typeof balances !== 'undefined' ? balances : null, pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : '' }) %>
    <div class="page-header">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;width:100%">
        <div>
          <h1 class="page-title" data-i18n="dash-overview">Overview</h1>
          <p class="page-subtitle"><span data-i18n="dash-welcome">Welcome back</span>, <%= user.name ? user.name.split(' ')[0] : user.email %></p>
        </div>
        <a href="/business/launch" class="btn btn-primary btn-sm" data-i18n="dash-launch-btn">+ Launch Business</a>
      </div>
    </div>
    <div class="page-body">
      <%- include('../partials/flash', { flash }) %>

      <!-- Wallet balances -->
      <div class="balance-strip mb-6">
        <div class="balance-item">
          <div class="balance-label" data-i18n="dash-bal-available">Available Balance</div>
          <div class="balance-amount">$<%= balances.available %></div>
        </div>
        <div class="balance-item">
          <div class="balance-label" data-i18n="dash-bal-pending">Pending</div>
          <div class="balance-amount pending">$<%= balances.pending %></div>
        </div>
        <div class="balance-item">
          <div class="balance-label" data-i18n="dash-bal-credits">AI Credits</div>
          <div class="balance-amount credits">$<%= balances.aiCredits %></div>
        </div>
      </div>

      <!-- Setup guidance for new users -->
      <% if (isSampleData && businesses.length === 0) { %>
      <div class="card mb-6" style="border-color:rgba(0,212,255,.2);background:rgba(0,212,255,.04)">
        <div class="card-body">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
            <span style="font-size:1.5rem">&#9889;</span>
            <div>
              <div style="font-size:1rem;font-weight:700;color:#fff" data-i18n="dash-setup-title">Get your business started in 4 steps</div>
              <div style="font-size:.8125rem;color:var(--text2)" data-i18n="dash-setup-sub">Complete the steps below to launch your first dropshipping store.</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px">
            <a href="/strategies" class="setup-step">
              <div class="setup-step-num">1</div><div class="setup-step-text" data-i18n="dash-step1">Choose Strategy</div><div class="setup-step-status">&#8594;</div>
            </a>
            <a href="/autopips" class="setup-step">
              <div class="setup-step-num">2</div><div class="setup-step-text" data-i18n="dash-step2">Add Products</div><div class="setup-step-status">&#8594;</div>
            </a>
            <a href="/agents" class="setup-step">
              <div class="setup-step-num">3</div><div class="setup-step-text" data-i18n="dash-step3">Hire Agent</div><div class="setup-step-status">&#8594;</div>
            </a>
            <a href="/wallet?tab=deposit" class="setup-step">
              <div class="setup-step-num">4</div><div class="setup-step-text" data-i18n="dash-step4">Fund Wallet</div><div class="setup-step-status">&#8594;</div>
            </a>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Quick actions -->
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px">
        <a href="/autopips" class="btn btn-outline btn-sm" data-i18n="dash-qa-products">&#128269; Discover Products</a>
        <a href="/studio/video" class="btn btn-outline btn-sm" data-i18n="dash-qa-video">&#127916; AI Video</a>
        <a href="/agents" class="btn btn-outline btn-sm" data-i18n="dash-qa-agent">&#128100; Find Agent</a>
        <a href="/wallet?tab=deposit" class="btn btn-gold btn-sm" data-i18n="dash-qa-deposit">+ Deposit</a>
      </div>

      <!-- Stats -->
      <div class="grid-4 mb-6">
        <div class="stat-card">
          <div class="stat-label" data-i18n="dash-stat-stores">Active Stores</div>
          <div class="stat-value"><%= businesses.length %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label" data-i18n="dash-stat-products">Products in Store</div>
          <div class="stat-value"><%= myProducts %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label" data-i18n="dash-stat-agents">Active Agents</div>
          <div class="stat-value" style="color:var(--green)"><%= myAgents.length %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label" data-i18n="dash-stat-tasks">Pending Tasks</div>
          <div class="stat-value" style="color:<%= pendingTasks > 0 ? 'var(--gold)' : 'var(--text)' %>"><%= pendingTasks %></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
        <!-- Active businesses -->
        <div class="card">
          <div class="card-header">
            <span class="card-title" data-i18n="dash-card-stores">My Stores</span>
            <a href="/business" class="btn btn-ghost btn-sm" data-i18n="dash-view-all">View all</a>
          </div>
          <% if (businesses.length === 0) { %>
          <div class="empty-state">
            <div class="icon">&#128218;</div>
            <p><span data-i18n="dash-empty-stores">No stores yet.</span> <a href="/business/launch" class="auth-link" data-i18n="dash-launch-first">Launch your first</a></p>
          </div>
          <% } else { %>
          <div>
            <% businesses.forEach(b => { %>
            <div style="padding:14px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
              <div>
                <div style="font-weight:600;color:#fff;font-size:.875rem"><%= b.name %></div>
                <div style="font-size:.78rem;color:var(--text3)"><%= b.niche || 'General' %></div>
              </div>
              <span class="pill pill-<%= b.status.toLowerCase() %>"><%= b.status %></span>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <!-- Active agents -->
        <div class="card">
          <div class="card-header">
            <span class="card-title" data-i18n="dash-card-agents">My Agents</span>
            <a href="/agents" class="btn btn-ghost btn-sm" data-i18n="dash-find-agents">Find agents</a>
          </div>
          <% if (myAgents.length === 0) { %>
          <div class="empty-state">
            <div class="icon">&#128100;</div>
            <p><span data-i18n="dash-empty-agents">No agents hired.</span> <a href="/agents" class="auth-link" data-i18n="dash-browse-agents">Browse agents</a></p>
          </div>
          <% } else { %>
          <div>
            <% myAgents.forEach(a => { %>
            <div style="padding:14px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px">
              <div class="agent-avatar" style="width:36px;height:36px;font-size:.8rem"><%= a.avatar_initials %></div>
              <div style="flex:1">
                <div style="font-weight:600;color:#fff;font-size:.875rem"><%= a.agent_name %></div>
                <div style="font-size:.78rem;color:var(--green)">&#9679; Active</div>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Recent transactions -->
      <div class="card mt-6">
        <div class="card-header">
          <span class="card-title" data-i18n="dash-card-wallet">Recent Wallet Activity</span>
          <a href="/wallet?tab=history" class="btn btn-ghost btn-sm" data-i18n="dash-view-all">View all</a>
        </div>
        <% if (recentTxns.length === 0) { %>
        <div class="empty-state">
          <div class="icon">&#128683;</div>
          <p><span data-i18n="dash-empty-txns">No transactions yet.</span> <a href="/wallet?tab=deposit" class="auth-link" data-i18n="dash-first-deposit">Make your first deposit</a></p>
        </div>
        <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th data-i18n="dash-th-type">Type</th><th data-i18n="dash-th-amount">Amount</th><th data-i18n="dash-th-balance">Balance</th><th data-i18n="dash-th-date">Date</th></tr></thead>
            <tbody>
              <% recentTxns.forEach(t => { %>
              <tr>
                <td><%= t.type.replace(/_/g,' ') %></td>
                <td class="tabular-nums" style="color:<%= parseFloat(t.amount) >= 0 ? 'var(--green)' : 'var(--red)' %>">
                  <%= parseFloat(t.amount) >= 0 ? '+' : '' %><%= parseFloat(t.amount).toFixed(8) %>
                </td>
                <td><span class="pill pill-<%= t.balance.toLowerCase() %>"><%= t.balance %></span></td>
                <td class="text-muted"><%= new Date(t.created_at).toLocaleDateString() %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
