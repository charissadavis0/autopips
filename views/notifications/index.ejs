<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Notifications — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { user, path, pendingWithdrawals }) %>
  <div class="main-content">
  <%- include('../partials/topbar', { user, balances: null, pageTitle: '' }) %>
    <div class="page-header">
      <h1 class="page-title">Notifications</h1>
      <p class="page-subtitle">Your recent activity and updates</p>
    </div>
    <div class="page-body">
      <% if (notifications.length === 0) { %>
      <div class="empty-state">
        <div style="font-size:2.5rem;margin-bottom:12px">🔔</div>
        <p>No notifications yet. Activity will appear here.</p>
      </div>
      <% } else { %>
      <div class="card">
        <% notifications.forEach((n, i) => { %>
        <div style="display:flex;gap:14px;padding:16px 20px;<%= i < notifications.length-1 ? 'border-bottom:1px solid var(--border)' : '' %>;<%= !n.read ? 'background:rgba(59,110,246,.03)' : '' %>">
          <div style="width:8px;height:8px;border-radius:50%;background:<%= n.read ? 'var(--border)' : 'var(--brand)' %>;flex-shrink:0;margin-top:7px"></div>
          <div style="flex:1">
            <div style="font-weight:600;color:<%= n.read ? 'var(--text)' : '#fff' %>;font-size:.875rem;margin-bottom:3px"><%= n.title %></div>
            <div style="font-size:.8125rem;color:var(--text2)"><%= n.message %></div>
            <div style="font-size:.75rem;color:var(--text3);margin-top:5px"><%= new Date(n.created_at).toLocaleString() %></div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
