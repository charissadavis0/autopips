<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('partials/sidebar', { user, path, pendingWithdrawals: 0 }) %>
  <div class="main-content">
  <%- include('partials/topbar', { user, balances: typeof balances !== 'undefined' ? balances : null, pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : '' }) %>
    <div class="page-header"><h1 class="page-title"><%= title %></h1></div>
    <div class="page-body">
      <div class="card" style="max-width:520px;text-align:center;padding:56px 40px">
        <div style="font-size:3rem;margin-bottom:20px">&#9889;</div>
        <div style="display:inline-block;padding:5px 14px;background:rgba(255,184,0,.12);border:1px solid rgba(255,184,0,.3);border-radius:100px;font-size:.75rem;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px">Coming Soon</div>
        <h2 style="font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:12px"><%= title %></h2>
        <p style="color:var(--text2);font-size:.9375rem;line-height:1.65"><%= message %></p>
        <div style="margin-top:28px">
          <a href="/dashboard" class="btn btn-outline">Back to Dashboard</a>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
