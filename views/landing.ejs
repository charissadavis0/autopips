<script>
(function() {
  const sel = document.getElementById('lang-selector')
  if (!sel) return
  const saved = localStorage.getItem('ap_lang') || navigator.language?.slice(0,2) || 'en'
  const opts = Array.from(sel.options).map(o => o.value)
  if (opts.includes(saved)) sel.value = saved
  sel.addEventListener('change', function() {
    localStorage.setItem('ap_lang', this.value)
    if (typeof window.applyLang === 'function') window.applyLang(this.value)
  })
})()
</script>

