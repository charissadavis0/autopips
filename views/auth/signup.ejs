<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Create Account — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-logo">AutoPips</div>
    <h2 class="auth-title" data-i18n="auth-signup-title">Create your account</h2>
    <p class="auth-sub" data-i18n="auth-signup-sub">Start your dropshipping journey today</p>
    <%- include('../partials/flash', { flash }) %>
    <form method="POST" action="/auth/signup">
      <div class="form-group">
        <label class="form-label" data-i18n="auth-name">Full name</label>
        <input class="form-input" type="text" name="name" required autofocus value="<%= typeof name !== 'undefined' ? name : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" data-i18n="auth-email">Email address</label>
        <input class="form-input" type="email" name="email" required value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" data-i18n="auth-password">Password</label>
        <input class="form-input" type="password" name="password" required minlength="8">
        <p class="form-hint">At least 8 characters</p>
      </div>
      <div class="alert alert-info" style="font-size:.8rem;margin-bottom:18px">
        AutoPips does not guarantee earnings. Results depend on your effort and market conditions.
      </div>
      <button type="submit" class="btn btn-primary w-full" data-i18n="auth-signup-btn">Create Account →</button>
    </form>
    <p class="text-center mt-4 text-muted" style="font-size:.875rem">
      <span data-i18n="auth-have-account">Already have an account?</span> <a href="/auth/login" class="auth-link" data-i18n="auth-signin-link">Sign in</a>
    </p>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
