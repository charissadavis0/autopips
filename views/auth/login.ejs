<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sign In — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-logo">AutoPips</div>
    <h2 class="auth-title" data-i18n="auth-signin-title">Welcome back</h2>
    <p class="auth-sub" data-i18n="auth-signin-sub">Sign in to your account to continue</p>
    <%- include('../partials/flash', { flash }) %>
    <form method="POST" action="/auth/login">
      <div class="form-group">
        <label class="form-label" data-i18n="auth-email">Email address</label>
        <input class="form-input" type="email" name="email" required autofocus value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" style="display:flex;justify-content:space-between;align-items:center">
          <span data-i18n="auth-password">Password</span>
          <a href="/auth/forgot-password" class="auth-link" style="font-size:.8rem;font-weight:500" data-i18n="auth-forgot">Forgot password?</a>
        </label>
        <input class="form-input" type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary w-full" style="margin-top:4px" data-i18n="auth-signin-btn">Sign In →</button>
    </form>
    <p class="text-center mt-4 text-muted" style="font-size:.875rem">
      <span data-i18n="auth-no-account">No account?</span> <a href="/auth/signup" class="auth-link" data-i18n="auth-create-free">Create one free</a>
    </p>
    <p style="text-align:center;margin-top:24px;font-size:.75rem;color:var(--text3)">
      By signing in you agree to our <a href="#" style="color:var(--text3);text-decoration:underline">Terms</a> and <a href="#" style="color:var(--text3);text-decoration:underline">Privacy Policy</a>.
    </p>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
