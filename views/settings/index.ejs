<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Settings — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { user, path, pendingWithdrawals: 0 }) %>
  <div class="main-content">
  <%- include('../partials/topbar', { user, balances: typeof balances !== 'undefined' ? balances : null, pageTitle: '' }) %>
    <div class="page-header">
      <h1 class="page-title">Settings</h1>
      <p class="page-subtitle">Manage your account, security, and preferences</p>
    </div>
    <div class="page-body">
      <%- include('../partials/flash', { flash }) %>

      <!-- Tabs -->
      <div class="tabs mb-6" style="width:fit-content">
        <% const tabs = ['profile','security','notifications','payment','business','plan','privacy'] %>
        <% const tabLabels = { profile:'Profile', security:'Security', notifications:'Notifications', payment:'Wallet & Payout', business:'Business', plan:'Account Plan', privacy:'Privacy' } %>
        <% tabs.forEach(t => { %>
        <a href="/settings?tab=<%= t %>" class="tab <%= (tab||'profile') === t ? 'active' : '' %>" style="text-decoration:none"><%= tabLabels[t] %></a>
        <% }) %>
      </div>

      <div style="max-width:580px">

        <!-- PROFILE TAB -->
        <% if ((tab||'profile') === 'profile') { %>
        <div class="card mb-4">
          <div class="card-header"><span class="card-title">Profile Information</span></div>
          <div class="card-body">
            <form method="POST" action="/settings/profile">
              <div class="form-group">
                <label class="form-label">Full name</label>
                <input class="form-input" type="text" name="name" value="<%= user.name || '' %>" placeholder="Your full name">
              </div>
              <div class="form-group">
                <label class="form-label">Email address</label>
                <input class="form-input" type="email" value="<%= user.email %>" disabled style="opacity:.6">
                <p class="form-hint">Email cannot be changed. Contact support if needed.</p>
              </div>
              <button class="btn btn-gold">Save Profile</button>
            </form>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Account Status</span></div>
          <div class="card-body">
            <div class="info-row"><span class="info-key">Account tier</span><span class="info-val"><span class="pill pill-<%= user.tier.toLowerCase() %>"><%= user.tier %></span></span></div>
            <div class="info-row"><span class="info-key">KYC level</span><span class="info-val"><%= user.kyc_level %></span></div>
            <div class="info-row"><span class="info-key">Role</span><span class="info-val"><%= user.role %></span></div>
            <div class="info-row"><span class="info-key">Member since</span><span class="info-val"><%= new Date(user.created_at).toLocaleDateString() %></span></div>
            <div class="info-row"><span class="info-key">Email verified</span><span class="info-val"><%= user.email_verified ? '✓ Verified' : '✗ Not verified' %></span></div>
          </div>
        </div>

        <!-- SECURITY TAB -->
        <% } else if (tab === 'security') { %>
        <div class="card mb-4">
          <div class="card-header"><span class="card-title">Change Password</span></div>
          <div class="card-body">
            <form method="POST" action="/settings/password">
              <div class="form-group">
                <label class="form-label">Current password</label>
                <input class="form-input" type="password" name="current_password" required placeholder="••••••••">
              </div>
              <div class="form-group">
                <label class="form-label">New password</label>
                <input class="form-input" type="password" name="new_password" required minlength="8" placeholder="8+ characters">
              </div>
              <div class="form-group">
                <label class="form-label">Confirm new password</label>
                <input class="form-input" type="password" name="confirm_password" required placeholder="Repeat new password">
              </div>
              <button class="btn btn-gold">Update Password</button>
            </form>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Sessions</span></div>
          <div class="card-body">
            <p class="text-muted text-sm mb-4">You are currently signed in. Signing out removes your session from this device.</p>
            <a href="/auth/logout" class="btn btn-danger btn-sm">Sign Out</a>
          </div>
        </div>

        <!-- NOTIFICATIONS TAB -->
        <% } else if (tab === 'notifications') { %>
        <div class="card">
          <div class="card-header"><span class="card-title">Notification Preferences</span></div>
          <div class="card-body">
            <form method="POST" action="/settings/notifications">
              <% const notifPrefs = user.notification_prefs ? JSON.parse(user.notification_prefs) : {} %>
              <div style="display:flex;flex-direction:column;gap:14px">
                <% const notifOptions = [
                  { key:'deposits', label:'Deposit updates', desc:'When a deposit is approved or declined' },
                  { key:'withdrawals', label:'Withdrawal updates', desc:'When a withdrawal is processed or rejected' },
                  { key:'agents', label:'Agent activity', desc:'Messages and updates from your hired agents' },
                  { key:'strategies', label:'Strategy updates', desc:'When new strategies are added or yours change status' },
                  { key:'products', label:'Product alerts', desc:'Stock or price changes on your products' },
                  { key:'system', label:'System announcements', desc:'Platform updates, downtime, and important notices' },
                ] %>
                <% notifOptions.forEach(opt => { %>
                <label style="display:flex;align-items:center;gap:12px;cursor:pointer">
                  <input type="checkbox" name="<%= opt.key %>" value="1"
                    <%= notifPrefs[opt.key] !== false ? 'checked' : '' %>
                    style="width:16px;height:16px;accent-color:var(--gold)">
                  <div>
                    <div style="font-weight:500"><%= opt.label %></div>
                    <div class="text-muted text-xs"><%= opt.desc %></div>
                  </div>
                </label>
                <% }) %>
              </div>
              <div style="margin-top:20px">
                <button class="btn btn-gold">Save Preferences</button>
              </div>
            </form>
          </div>
        </div>

        <!-- PAYMENT / WALLET TAB -->
        <% } else if (tab === 'payment') { %>
        <div class="card mb-4">
          <div class="card-header"><span class="card-title">Wallet Balances</span></div>
          <div class="card-body">
            <% const b = typeof balances !== 'undefined' ? balances : { available:'0.00', pending:'0.00', aiCredits:'0.00' } %>
            <div class="info-row"><span class="info-key">Available balance</span><span class="info-val font-semibold">$<%= parseFloat(b.available).toFixed(2) %></span></div>
            <div class="info-row"><span class="info-key">Pending</span><span class="info-val">$<%= parseFloat(b.pending).toFixed(2) %></span></div>
            <div class="info-row"><span class="info-key">AI Credits</span><span class="info-val">$<%= parseFloat(b.aiCredits).toFixed(2) %></span></div>
            <div style="margin-top:16px;display:flex;gap:10px">
              <a href="/wallet" class="btn btn-gold btn-sm">Deposit Funds</a>
              <a href="/wallet?tab=withdraw" class="btn btn-outline btn-sm">Withdraw</a>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Payout Settings</span></div>
          <div class="card-body">
            <p class="text-muted text-sm">Payout account management is coming soon. You can currently withdraw via the Wallet page.</p>
            <a href="/wallet" class="btn btn-outline btn-sm mt-4" style="margin-top:12px">Go to Wallet</a>
          </div>
        </div>

        <!-- BUSINESS TAB -->
        <% } else if (tab === 'business') { %>
        <div class="card mb-4">
          <div class="card-header"><span class="card-title">My Stores</span></div>
          <div class="card-body">
            <% if (!businesses || businesses.length === 0) { %>
            <p class="text-muted text-sm mb-4">You haven't launched a business yet.</p>
            <a href="/business/launch" class="btn btn-gold btn-sm">Launch My Business</a>
            <% } else { %>
            <% businesses.forEach(biz => { %>
            <div style="padding:12px;border:1px solid var(--border);border-radius:8px;margin-bottom:10px">
              <div style="display:flex;align-items:center;justify-content:space-between">
                <div>
                  <div style="font-weight:600"><%= biz.name %></div>
                  <div class="text-muted text-xs"><%= biz.sourcing_method %> &middot; <span class="pill pill-<%= biz.status.toLowerCase() %>"><%= biz.status %></span></div>
                </div>
                <a href="/business" class="btn btn-ghost btn-sm">Manage</a>
              </div>
            </div>
            <% }) %>
            <a href="/business/launch" class="btn btn-outline btn-sm">+ New Business</a>
            <% } %>
          </div>
        </div>

        <!-- ACCOUNT PLAN TAB -->
        <% } else if (tab === 'plan') { %>
        <% const tierDefs = {
          STANDARD: { price: 0, label: 'Standard', color: '#94A3B8', benefits: ['Access to AI product catalog','Up to 3 active stores','Basic analytics','Community support'], aiCredits: 0, limit: '3 stores' },
          GOLD:     { price: 49, label: 'Gold', color: '#FFB800', benefits: ['Everything in Standard','Up to 10 active stores','$50 AI credits/month','Priority support','Automated sourcing tools','Advanced analytics'], aiCredits: 50, limit: '10 stores' },
          PLATINUM: { price: 149, label: 'Platinum', color: '#00D4FF', benefits: ['Everything in Gold','Unlimited stores','$200 AI credits/month','Dedicated account manager','Custom branding','VIP support','Early access to new features'], aiCredits: 200, limit: 'Unlimited stores' },
        } %>
        <% const currentTier = user.tier || 'STANDARD' %>
        <div class="card mb-4">
          <div class="card-header"><span class="card-title">Current Plan</span></div>
          <div class="card-body">
            <div style="display:flex;align-items:center;gap:14px;padding:14px;background:var(--bg2);border-radius:10px;border:1px solid var(--border)">
              <div style="width:48px;height:48px;border-radius:10px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:1.3rem">
                <%= currentTier === 'PLATINUM' ? '💎' : currentTier === 'GOLD' ? '⭐' : '🔷' %>
              </div>
              <div>
                <div style="font-size:1.1rem;font-weight:700;color:<%= tierDefs[currentTier]?.color || '#fff' %>"><%= currentTier %></div>
                <div class="text-muted text-sm"><%= currentTier === 'STANDARD' ? 'Free plan' : '$' + tierDefs[currentTier]?.price + '/month' %></div>
              </div>
              <div style="margin-left:auto">
                <span class="pill pill-<%= currentTier.toLowerCase() %>">Active</span>
              </div>
            </div>
          </div>
        </div>

        <% if (currentTier !== 'PLATINUM') { %>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
          <% ['GOLD','PLATINUM'].filter(t => t !== currentTier && (currentTier === 'STANDARD' || t === 'PLATINUM')).forEach(tier => { %>
          <% const def = tierDefs[tier] %>
          <div class="card" style="border-color:<%= def.color %>44">
            <div class="card-body">
              <div style="font-size:1.1rem;font-weight:700;color:<%= def.color %>;margin-bottom:4px">
                <%= tier === 'PLATINUM' ? '💎' : '⭐' %> <%= def.label %>
              </div>
              <div style="font-size:1.5rem;font-weight:800;margin-bottom:12px">$<%= def.price %><span style="font-size:.85rem;font-weight:400;color:var(--text3)">/month</span></div>
              <ul style="list-style:none;padding:0;margin:0 0 16px;display:flex;flex-direction:column;gap:6px">
                <% def.benefits.forEach(b => { %>
                <li style="font-size:.825rem;color:var(--text2);display:flex;gap:8px"><span style="color:<%= def.color %>">✓</span><%= b %></li>
                <% }) %>
              </ul>
              <div style="font-size:.8rem;color:var(--text3);margin-bottom:14px"><%= def.aiCredits > 0 ? def.aiCredits + ' AI credits/month included' : 'No AI credits' %></div>
              <form method="POST" action="/settings/upgrade" data-confirm="Upgrade to <%= def.label %> for $<%= def.price %>/month? This will deduct from your wallet.">
                <input type="hidden" name="tier" value="<%= tier %>">
                <button class="btn w-full" style="background:<%= def.color %>;color:#000;font-weight:700">Upgrade to <%= def.label %></button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div class="card">
          <div class="card-body">
            <p class="text-muted">You are on the highest plan. Enjoy all Platinum benefits.</p>
          </div>
        </div>
        <% } %>

        <div class="card">
          <div class="card-header"><span class="card-title">Plan Comparison</span></div>
          <div class="card-body" style="overflow-x:auto">
            <table style="width:100%;font-size:.85rem;border-collapse:collapse">
              <thead>
                <tr>
                  <th style="text-align:left;padding:8px 12px;border-bottom:1px solid var(--border)">Feature</th>
                  <% ['STANDARD','GOLD','PLATINUM'].forEach(t => { %>
                  <th style="text-align:center;padding:8px 12px;border-bottom:1px solid var(--border);color:<%= tierDefs[t].color %>"><%= t %></th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% const rows = [
                  ['Monthly price', '$0', '$49', '$149'],
                  ['Active stores', '3', '10', 'Unlimited'],
                  ['AI credits/month', '0', '$50', '$200'],
                  ['Support', 'Community', 'Priority', 'VIP + Manager'],
                  ['Advanced analytics', '✗', '✓', '✓'],
                  ['Custom branding', '✗', '✗', '✓'],
                ] %>
                <% rows.forEach(row => { %>
                <tr>
                  <td style="padding:8px 12px;border-bottom:1px solid var(--border);color:var(--text2)"><%= row[0] %></td>
                  <% [1,2,3].forEach(i => { %>
                  <td style="padding:8px 12px;border-bottom:1px solid var(--border);text-align:center;
                    <% if (currentTier === ['STANDARD','GOLD','PLATINUM'][i-1]) { %>font-weight:600;<% } %>">
                    <%= row[i] %>
                  </td>
                  <% }) %>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- PRIVACY TAB -->
        <% } else if (tab === 'privacy') { %>
        <div class="card mb-4">
          <div class="card-header"><span class="card-title">Privacy Controls</span></div>
          <div class="card-body">
            <div class="info-banner" style="margin-bottom:16px">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Your data is encrypted and never shared with third parties without your consent.
            </div>
            <div class="info-row"><span class="info-key">Account data</span><span class="info-val text-muted text-sm">Stored securely</span></div>
            <div class="info-row"><span class="info-key">Transaction records</span><span class="info-val text-muted text-sm">7 years retention (regulatory)</span></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Danger Zone</span></div>
          <div class="card-body">
            <p class="text-muted text-sm mb-4">Account deletion permanently removes all your data and cannot be undone. Contact support to request deletion.</p>
            <a href="mailto:support@autopips.com?subject=Account deletion request" class="btn btn-danger btn-sm">Request Account Deletion</a>
          </div>
        </div>
        <% } %>

      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
