<header class="topbar">
  <div class="topbar-left">
    <button class="topbar-menu-btn" onclick="document.getElementById('sidebar').classList.toggle('open')" aria-label="Menu">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="topbar-title">
      <% if (typeof pageTitle !== 'undefined' && pageTitle) { %>
      <%= pageTitle %>
      <% } %>
    </div>
  </div>

  <div class="topbar-right">
    <% if (typeof balances !== 'undefined' && balances) { %>
    <div class="topbar-balance">
      <span class="topbar-balance-label">Balance</span>
      <span class="topbar-balance-val">$<%= (parseFloat(balances.available) || 0).toFixed(2) %></span>
    </div>
    <% } %>

    <a href="/wallet" class="topbar-action" title="Wallet">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v9a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><circle cx="17" cy="13" r="1" fill="currentColor"/></svg>
    </a>

    <div class="notif-btn topbar-action" id="notifBtn" title="Notifications" style="position:relative;cursor:pointer">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      <span class="notif-dot" id="notifDot" style="display:none;position:absolute;top:4px;right:4px;width:7px;height:7px;border-radius:50%;background:var(--red);border:2px solid var(--bg)"></span>
    </div>
    <div class="notif-panel" id="notifPanel" style="display:none;position:absolute;top:calc(100% + 8px);right:40px;width:320px;background:linear-gradient(160deg,rgba(20,28,54,.98),rgba(10,15,30,.98));border:1px solid var(--border2);border-radius:4px;z-index:200;box-shadow:0 16px 40px rgba(0,0,0,.5);overflow:hidden">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border)">
        <span style="font-weight:700;color:#fff;font-size:.875rem;font-family:'Space Grotesk',sans-serif">Notifications</span>
        <button id="notifMarkAll" style="background:none;border:none;color:var(--brand);font-size:.78rem;font-weight:600;cursor:pointer">Mark all read</button>
      </div>
      <div id="notifList" style="max-height:360px;overflow-y:auto"></div>
      <div style="padding:10px 16px;border-top:1px solid var(--border);text-align:center">
        <a href="/notifications" style="font-size:.8rem;color:var(--brand);font-weight:500">View all notifications</a>
      </div>
    </div>

    <div class="topbar-user" onclick="this.parentElement.querySelector('.topbar-dropdown').classList.toggle('open')">
      <div class="topbar-avatar"><%= user ? (user.name || user.email).charAt(0).toUpperCase() : 'U' %></div>
      <div class="topbar-user-info">
        <span class="topbar-user-name"><%= user ? (user.name || user.email.split('@')[0]) : 'User' %></span>
        <span class="topbar-user-tier"><%= user ? user.tier : '' %></span>
      </div>
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="topbar-dropdown">
      <a href="/settings" class="topbar-dd-item">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06A1.65 1.65 0 0015 19.4a1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Settings
      </a>
      <% if (user && ['SUPER_ADMIN','COMPLIANCE','SUPPORT','FINANCE'].includes(user.role)) { %>
      <a href="/admin" class="topbar-dd-item">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Admin Panel
      </a>
      <% } %>
      <div class="topbar-dd-divider"></div>
      <a href="/auth/logout" class="topbar-dd-item topbar-dd-danger">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign Out
      </a>
    </div>
  </div>
</header>
