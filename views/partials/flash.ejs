<% if (typeof flash !== 'undefined') { %>
  <% if (flash.error) { %><div class="alert alert-error" data-dismiss="5000"><%= flash.error %></div><% } %>
  <% if (flash.success) { %><div class="alert alert-success" data-dismiss="5000"><%= flash.success %></div><% } %>
  <% if (flash.warn) { %><div class="alert alert-warn" data-dismiss="5000"><%= flash.warn %></div><% } %>
<% } %>
