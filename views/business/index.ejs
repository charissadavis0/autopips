<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>My Business — AutoPips</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { user, path, pendingWithdrawals: 0 }) %>
  <div class="main-content">
  <%- include('../partials/topbar', { user, balances: typeof balances !== 'undefined' ? balances : null, pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : '' }) %>
    <div class="page-header">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;width:100%">
        <div>
          <h1 class="page-title">My Stores</h1>
          <p class="page-subtitle">Manage your dropshipping business workspaces</p>
        </div>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('new-biz-modal').classList.remove('hidden')">+ New Store</button>
      </div>
    </div>
    <div class="page-body">
      <%- include('../partials/flash', { flash }) %>
      <% if (flash.success === 'agent_hired') { %><div class="alert alert-success">Agent hired! They will reach out to you shortly.</div><% } %>
      <% if (flash.success === 'launched') { %><div class="alert alert-success">Your business is now live!</div><% } %>
      <% if (flash.launched) { %><div class="alert alert-success">Strategy copied and business workspace created! <a href="/agents" style="color:var(--gold)">Consider hiring an agent to manage it &#8594;</a></div><% } %>

      <!-- Active agents banner -->
      <% if (myAgents.length > 0) { %>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px">
        <% myAgents.forEach(a => { %>
        <div style="background:var(--card);border:1px solid rgba(0,230,118,.2);border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:10px">
          <div class="agent-avatar" style="width:36px;height:36px;font-size:.8rem"><%= a.avatar_initials %></div>
          <div>
            <div style="font-size:.8125rem;font-weight:600;color:#fff"><%= a.agent_name %></div>
            <div style="font-size:.75rem;color:var(--green)">&#9679; Active agent</div>
          </div>
          <form method="POST" action="/agents/assignment/<%= a.id %>/end" onsubmit="return confirm('End this agent assignment?')">
            <button type="submit" class="btn btn-ghost btn-sm" style="font-size:.75rem;color:var(--text3)">End</button>
          </form>
        </div>
        <% }) %>
      </div>
      <% } %>

      <% if (businesses.length === 0) { %>
      <div class="card" style="text-align:center;padding:48px">
        <div style="font-size:2.5rem;margin-bottom:16px">&#128218;</div>
        <h3 style="color:#fff;margin-bottom:8px">No stores yet</h3>
        <p style="color:var(--text2);margin-bottom:24px">Start by copying a strategy or creating a new store from scratch.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a href="/strategies" class="btn btn-primary">Browse Strategies</a>
          <button class="btn btn-outline" onclick="document.getElementById('new-biz-modal').classList.remove('hidden')">Create Manually</button>
        </div>
      </div>
      <% } else { %>
      <div style="display:flex;flex-direction:column;gap:16px">
        <% businesses.forEach(b => { %>
        <div class="card">
          <div class="card-body" style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap">
            <div style="flex:1">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
                <span style="font-size:1.1rem;font-weight:700;color:#fff"><%= b.name %></span>
                <span class="pill pill-<%= b.status.toLowerCase() %>"><%= b.status %></span>
                <span class="pill" style="background:rgba(0,212,255,.1);color:var(--cyan)"><%= b.mode %></span>
              </div>
              <% if (b.niche) { %><div style="font-size:.875rem;color:var(--text2);margin-bottom:4px">Niche: <strong style="color:var(--text)"><%= b.niche %></strong></div><% } %>
              <% if (b.strategy_name) { %><div style="font-size:.875rem;color:var(--text2);margin-bottom:4px">Strategy: <strong style="color:var(--cyan)"><%= b.strategy_name %></strong></div><% } %>
              <div style="font-size:.8rem;color:var(--text3)">Created <%= new Date(b.created_at).toLocaleDateString() %>
              <% if (b.launch_date) { %> &nbsp;|&nbsp; Launched <%= new Date(b.launch_date).toLocaleDateString() %><% } %></div>
            </div>
            <div style="display:flex;gap:8px;flex-shrink:0">
              <a href="/business/products" class="btn btn-ghost btn-sm">Products</a>
              <% if (b.status === 'SETUP') { %>
              <form method="POST" action="/business/<%= b.id %>/launch">
                <button type="submit" class="btn btn-primary btn-sm">Launch &#8594;</button>
              </form>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>

      <!-- Quick stats -->
      <div class="grid-4 mt-6">
        <div class="stat-card"><div class="stat-label">Products in Stores</div><div class="stat-value"><%= myProducts.count %></div></div>
        <div class="stat-card"><div class="stat-label">Active Agents</div><div class="stat-value" style="color:var(--green)"><%= myAgents.length %></div></div>
        <div class="stat-card"><div class="stat-label">Available Balance</div><div class="stat-value" style="color:var(--cyan)">$<%= balances.available %></div></div>
        <div class="stat-card"><div class="stat-label">Total Stores</div><div class="stat-value"><%= businesses.length %></div></div>
      </div>
    </div>
  </div>
</div>

<!-- New Business Modal -->
<div id="new-biz-modal" class="modal-backdrop hidden">
  <div class="modal">
    <div class="modal-title">Create New Store</div>
    <form method="POST" action="/business/create">
      <div class="form-group">
        <label class="form-label">Store Name</label>
        <input class="form-input" type="text" name="name" placeholder="e.g. TechGadgets Store" required>
      </div>
      <div class="form-group">
        <label class="form-label">Niche</label>
        <input class="form-input" type="text" name="niche" placeholder="e.g. Electronics, Beauty, Fitness">
      </div>
      <div class="form-group">
        <label class="form-label">Operating Mode</label>
        <select class="form-select" name="mode">
          <option value="INDEPENDENT">Independent (I manage it)</option>
          <option value="MANAGED">Managed (agent manages it)</option>
        </select>
      </div>
      <div style="display:flex;gap:10px">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('new-biz-modal').classList.add('hidden')">Cancel</button>
        <button type="submit" class="btn btn-primary" style="flex:1">Create Store</button>
      </div>
    </form>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
